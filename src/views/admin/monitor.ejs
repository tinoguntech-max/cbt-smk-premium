<div class="flex items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Server Monitor</h1>
    <p class="mt-1 text-slate-500 text-sm">Realtime status VPS 1 · Auto-refresh setiap 3 detik</p>
  </div>
  <div class="flex items-center gap-3">
    <span id="lastUpdate" class="text-xs text-slate-400"></span>
    <span id="statusDot" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">
      <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Live
    </span>
    <a href="/admin" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-100 text-sm font-medium">← Kembali</a>
  </div>
</div>

<!-- Grid utama -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
  <!-- CPU -->
  <div class="rounded-2xl border border-blue-200 bg-gradient-to-br from-blue-50 to-blue-100 p-5">
    <div class="flex items-center justify-between mb-3">
      <span class="text-sm font-semibold text-blue-700">CPU Load</span>
      <span class="text-2xl">🖥️</span>
    </div>
    <div class="text-3xl font-bold text-blue-900" id="cpuLoad">-</div>
    <div class="mt-2 h-2 rounded-full bg-blue-200 overflow-hidden">
      <div id="cpuBar" class="h-full rounded-full bg-blue-500 transition-all duration-500" style="width:0%"></div>
    </div>
  </div>

  <!-- RAM -->
  <div class="rounded-2xl border border-purple-200 bg-gradient-to-br from-purple-50 to-purple-100 p-5">
    <div class="flex items-center justify-between mb-3">
      <span class="text-sm font-semibold text-purple-700">RAM</span>
      <span class="text-2xl">💾</span>
    </div>
    <div class="text-3xl font-bold text-purple-900" id="ramUsed">-</div>
    <div class="text-xs text-purple-600 mt-1" id="ramDetail">-</div>
    <div class="mt-2 h-2 rounded-full bg-purple-200 overflow-hidden">
      <div id="ramBar" class="h-full rounded-full bg-purple-500 transition-all duration-500" style="width:0%"></div>
    </div>
  </div>

  <!-- Koneksi -->
  <div class="rounded-2xl border border-green-200 bg-gradient-to-br from-green-50 to-green-100 p-5">
    <div class="flex items-center justify-between mb-3">
      <span class="text-sm font-semibold text-green-700">Koneksi Aktif</span>
      <span class="text-2xl">🌐</span>
    </div>
    <div class="text-3xl font-bold text-green-900" id="connections">-</div>
    <div class="text-xs text-green-600 mt-1">ke port 3000</div>
  </div>

  <!-- Disk -->
  <div class="rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50 to-orange-100 p-5">
    <div class="flex items-center justify-between mb-3">
      <span class="text-sm font-semibold text-orange-700">Disk</span>
      <span class="text-2xl">💿</span>
    </div>
    <div class="text-3xl font-bold text-orange-900" id="diskUsed">-</div>
    <div class="text-xs text-orange-600 mt-1" id="diskDetail">-</div>
  </div>
</div>

<!-- PM2 Instances -->
<div class="rounded-2xl border border-slate-200 bg-white p-5 mb-4">
  <h2 class="font-semibold text-slate-800 mb-4 flex items-center gap-2">
    <span>⚡</span> PM2 Instances
  </h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-slate-500 border-b border-slate-100">
          <th class="pb-2 pr-4">ID</th>
          <th class="pb-2 pr-4">Name</th>
          <th class="pb-2 pr-4">Status</th>
          <th class="pb-2 pr-4">CPU</th>
          <th class="pb-2 pr-4">RAM</th>
          <th class="pb-2 pr-4">Restarts</th>
          <th class="pb-2">Uptime</th>
        </tr>
      </thead>
      <tbody id="pm2Table">
        <tr><td colspan="7" class="py-4 text-center text-slate-400">Loading...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- DB & Redis -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <!-- MySQL -->
  <div class="rounded-2xl border border-teal-200 bg-gradient-to-br from-teal-50 to-teal-100 p-5">
    <h2 class="font-semibold text-teal-800 mb-4 flex items-center gap-2">
      <span>🗄️</span> MySQL
    </h2>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between">
        <span class="text-teal-700">Koneksi aktif</span>
        <span class="font-bold text-teal-900" id="dbConnections">-</span>
      </div>
      <div class="flex justify-between">
        <span class="text-teal-700">Uptime</span>
        <span class="font-bold text-teal-900" id="dbUptime">-</span>
      </div>
    </div>
  </div>

  <!-- Redis -->
  <div class="rounded-2xl border border-red-200 bg-gradient-to-br from-red-50 to-red-100 p-5">
    <h2 class="font-semibold text-red-800 mb-4 flex items-center gap-2">
      <span>⚡</span> Redis
    </h2>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between">
        <span class="text-red-700">Status</span>
        <span id="redisStatus" class="font-bold">-</span>
      </div>
      <div class="flex justify-between">
        <span class="text-red-700">Memory</span>
        <span class="font-bold text-red-900" id="redisMemory">-</span>
      </div>
      <div class="flex justify-between">
        <span class="text-red-700">Clients</span>
        <span class="font-bold text-red-900" id="redisClients">-</span>
      </div>
    </div>
  </div>
</div>

<script>
function formatUptime(ms) {
  const s = Math.floor(ms / 1000);
  if (s < 60) return s + 'd';
  const m = Math.floor(s / 60);
  if (m < 60) return m + 'm';
  const h = Math.floor(m / 60);
  if (h < 24) return h + 'j ' + (m % 60) + 'm';
  return Math.floor(h / 24) + 'h ' + (h % 24) + 'j';
}

function statusBadge(status) {
  const colors = {
    online:   'bg-green-100 text-green-700',
    errored:  'bg-red-100 text-red-700',
    stopped:  'bg-slate-100 text-slate-600',
    launching:'bg-yellow-100 text-yellow-700'
  };
  return `<span class="px-2 py-0.5 rounded-full text-xs font-semibold ${colors[status] || 'bg-slate-100 text-slate-600'}">${status}</span>`;
}

async function fetchData() {
  try {
    const res = await fetch('/admin/monitor/data');
    const d = await res.json();

    // Last update
    document.getElementById('lastUpdate').textContent = new Date(d.timestamp).toLocaleTimeString('id-ID');

    // CPU
    document.getElementById('cpuLoad').textContent = d.system.cpuLoad.toFixed(1) + '%';
    document.getElementById('cpuBar').style.width = Math.min(d.system.cpuLoad, 100) + '%';
    document.getElementById('cpuBar').className = `h-full rounded-full transition-all duration-500 ${d.system.cpuLoad > 80 ? 'bg-red-500' : d.system.cpuLoad > 50 ? 'bg-yellow-500' : 'bg-blue-500'}`;

    // RAM
    const ramPct = d.system.memTotal ? Math.round(d.system.memUsed / d.system.memTotal * 100) : 0;
    document.getElementById('ramUsed').textContent = d.system.memUsed + ' MB';
    document.getElementById('ramDetail').textContent = `${ramPct}% dari ${d.system.memTotal} MB`;
    document.getElementById('ramBar').style.width = ramPct + '%';
    document.getElementById('ramBar').className = `h-full rounded-full transition-all duration-500 ${ramPct > 80 ? 'bg-red-500' : ramPct > 60 ? 'bg-yellow-500' : 'bg-purple-500'}`;

    // Koneksi & Disk
    document.getElementById('connections').textContent = d.system.connections;
    document.getElementById('diskUsed').textContent = d.system.diskUsed;
    document.getElementById('diskDetail').textContent = `${d.system.diskPercent} terpakai · sisa ${d.system.diskFree}`;

    // PM2
    const tbody = document.getElementById('pm2Table');
    if (d.pm2.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="py-4 text-center text-slate-400">Tidak ada proses</td></tr>';
    } else {
      tbody.innerHTML = d.pm2.map(p => `
        <tr class="border-b border-slate-50 hover:bg-slate-50">
          <td class="py-2 pr-4 text-slate-500">${p.id}</td>
          <td class="py-2 pr-4 font-medium">${p.name}</td>
          <td class="py-2 pr-4">${statusBadge(p.status)}</td>
          <td class="py-2 pr-4">${p.cpu}%</td>
          <td class="py-2 pr-4">${p.memory} MB</td>
          <td class="py-2 pr-4 ${p.restarts > 5 ? 'text-red-600 font-bold' : ''}">${p.restarts}</td>
          <td class="py-2">${formatUptime(p.uptime)}</td>
        </tr>
      `).join('');
    }

    // DB
    document.getElementById('dbConnections').textContent = d.db.connections;
    const dbUptimeH = Math.floor(d.db.uptime / 3600);
    document.getElementById('dbUptime').textContent = dbUptimeH + ' jam';

    // Redis
    document.getElementById('redisStatus').textContent = d.redis.connected ? '✅ Connected' : '❌ Offline';
    document.getElementById('redisStatus').className = `font-bold ${d.redis.connected ? 'text-green-600' : 'text-red-600'}`;
    document.getElementById('redisMemory').textContent = d.redis.memory;
    document.getElementById('redisClients').textContent = d.redis.clients;

  } catch(e) {
    document.getElementById('statusDot').innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500"></span> Error';
    document.getElementById('statusDot').className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700';
  }
}

fetchData();
setInterval(fetchData, 3000);
</script>
