<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&family=Source+Code+Pro:wght@600;700&display=swap');
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Poppins', 'Segoe UI', sans-serif; background: #f0f0f0; }

    /* ===== PRINT CONTROLS ===== */
    .print-controls {
      text-align: center; padding: 20px; background: white;
      margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .print-controls h2 { color: #1a5c2a; margin-bottom: 12px; font-size: 18px; }
    .filter-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 12px; }
    .filter-select {
      padding: 7px 14px; border-radius: 8px; border: 2px solid #e2e8f0;
      font-size: 13px; font-weight: 600; color: #475569; background: white; cursor: pointer;
    }
    .filter-select:focus { outline: none; border-color: #1a5c2a; }
    .btn {
      display: inline-block; padding: 9px 20px; margin: 0 5px;
      border-radius: 8px; font-weight: 600; text-decoration: none;
      cursor: pointer; border: none; font-size: 13px;
    }
    .btn-print { background: #1a5c2a; color: white; }
    .btn-print:hover { background: #145022; }
    .btn-back  { background: #e2e8f0; color: #475569; }

    /* Pagination */
    .pagination {
      display: flex; gap: 6px; justify-content: center;
      align-items: center; margin-top: 16px; flex-wrap: wrap;
    }
    .page-info { font-size: 13px; color: #555; margin: 0 8px; }
    .page-btn {
      padding: 6px 14px; border-radius: 6px; border: 2px solid #1a5c2a;
      background: white; color: #1a5c2a; font-weight: 600; font-size: 13px;
      cursor: pointer; transition: all 0.15s;
    }
    .page-btn:hover, .page-btn.active { background: #1a5c2a; color: white; }
    .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* ===== A4 PAGE ===== */
    .a4-page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto 10mm;
      background: white;
      padding: 8mm;
      box-shadow: 0 2px 12px rgba(0,0,0,0.15);
      display: none; /* hidden by default, JS shows active page */
    }
    .a4-page.active { display: block; }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 5mm;
    }

    /* ===== KARTU ===== */
    .login-card {
      width: 95mm;
      height: 62mm;
      background: white;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
      box-shadow: 0 1px 4px rgba(0,0,0,0.12);
      display: flex;
      flex-direction: column;
      border: 1px solid #e0e0e0;
    }

    .card-header {
      background: #1a7a35;
      padding: 5px 8px;
      display: flex; align-items: center; gap: 6px;
      min-height: 16mm;
      position: relative; overflow: hidden;
    }
    .card-header::after {
      content: '';
      position: absolute; top: 0; right: 0;
      width: 0; height: 0; border-style: solid;
      border-width: 0 16mm 16mm 0;
      border-color: transparent #e07b00 transparent transparent;
    }
    .card-logo {
      width: 26px; height: 26px; background: white;
      border-radius: 4px; display: flex; align-items: center;
      justify-content: center; flex-shrink: 0; padding: 2px; z-index: 1;
    }
    .card-logo img { width: 100%; height: 100%; object-fit: contain; }
    .card-school-info { z-index: 1; }
    .school-name { font-size: 9.5px; font-weight: 800; color: white; line-height: 1.3; font-family: 'Poppins', sans-serif; }
    .school-sub  { font-size: 7px; color: rgba(255,255,255,0.85); margin-top: 1px; font-family: 'Poppins', sans-serif; }

    .card-body {
      flex: 1; display: flex; padding: 4px 6px; gap: 5px;
      position: relative; overflow: hidden;
    }
    .card-body::before {
      content: ''; position: absolute; bottom: 0; left: 0;
      width: 0; height: 0; border-style: solid;
      border-width: 10mm 0 0 10mm;
      border-color: transparent transparent transparent #1a7a35;
      opacity: 0.12;
    }
    .card-body::after {
      content: ''; position: absolute; bottom: 0; right: 0;
      width: 0; height: 0; border-style: solid;
      border-width: 0 0 8mm 8mm;
      border-color: transparent transparent #1a7a35 transparent;
      opacity: 0.10;
    }

    .card-left { flex: 1; display: flex; flex-direction: column; justify-content: center; z-index: 1; }
    .card-title {
      font-size: 15px; font-weight: 900; color: #1a5c2a;
      text-transform: uppercase; letter-spacing: 1px; line-height: 1.1; margin-bottom: 3px;
      font-family: 'Poppins', sans-serif;
    }
    .card-title-underline {
      width: 26mm; height: 3px;
      background: linear-gradient(to right, #1a7a35 60%, #e07b00 40%);
      margin-bottom: 5px;
    }
    .info-row {
      display: flex; align-items: flex-start;
      font-size: 10.5px; color: #1a1a1a; margin-bottom: 3px; line-height: 1.4;
      font-family: 'Poppins', sans-serif;
    }
    .info-label { width: 18mm; font-weight: 700; color: #1a5c2a; flex-shrink: 0; }
    .info-sep   { margin-right: 4px; color: #555; font-weight: 600; }
    .info-value { font-weight: 500; color: #111; word-break: break-all; }
    .info-value.mono {
      font-family: 'Source Code Pro', 'Courier New', monospace;
      font-weight: 700; font-size: 10px;
      color: #0f172a; letter-spacing: 0.3px;
    }

    .card-photo-wrap {
      width: 20mm; display: flex; align-items: center;
      justify-content: center; flex-shrink: 0; z-index: 1;
    }
    .hexagon {
      width: 18mm; height: 20mm;
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      background: #1a7a35; display: flex; align-items: center;
      justify-content: center; overflow: hidden;
    }
    .hexagon img { width: 100%; height: 100%; object-fit: cover; }
    .hexagon-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 20px; color: white; }

    .card-footer {
      background: #1a7a35; padding: 2px 8px;
      text-align: center; font-size: 6px;
      color: rgba(255,255,255,0.9); letter-spacing: 0.3px;
    }

    /* ===== PRINT ===== */
    @media print {
      body { background: white; }
      .print-controls { display: none; }
      .a4-page {
        display: block !important;
        width: 100%; margin: 0; padding: 5mm;
        box-shadow: none;
        page-break-after: always;
      }
      .a4-page:last-child { page-break-after: auto; }
      .login-card { box-shadow: none; }
      @page { size: A4; margin: 5mm; }
    }
  </style>
</head>
<body>

  <!-- Print Controls -->
  <div class="print-controls">
    <h2>Cetak Kartu Login &mdash; <%= users.length %> Kartu</h2>

    <form method="GET" action="/admin/users/print-cards" class="filter-row">
      <select name="role" class="filter-select" onchange="this.form.submit()">
        <option value="">Semua Role</option>
        <option value="TEACHER" <%= role === 'TEACHER' ? 'selected' : '' %>>Guru</option>
        <option value="STUDENT" <%= role === 'STUDENT' ? 'selected' : '' %>>Siswa</option>
      </select>
      <select name="class_id" class="filter-select" onchange="this.form.submit()">
        <option value="">Semua Kelas</option>
        <% classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= class_id == c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
      <button type="button" onclick="window.location.href='/admin/users/print-cards'" class="btn btn-back">Reset</button>
    </form>

    <div>
      <button onclick="window.print()" class="btn btn-print">🖨️ Cetak Semua</button>
      <a href="/admin/users" class="btn btn-back">← Kembali</a>
    </div>

    <!-- Pagination -->
    <div class="pagination" id="pagination"></div>
    <div class="page-info" id="pageInfo"></div>
  </div>

  <!-- Pages -->
  <%
    const CARDS_PER_PAGE = 8;
    const totalPages = Math.ceil(users.length / CARDS_PER_PAGE);
  %>

  <% for (let p = 0; p < totalPages; p++) { %>
    <div class="a4-page <%= p === 0 ? 'active' : '' %>" id="page-<%= p %>">
      <div class="cards-grid">
        <% for (let j = p * CARDS_PER_PAGE; j < Math.min((p + 1) * CARDS_PER_PAGE, users.length); j++) {
          const user = users[j];
          const roleText = user.role === 'TEACHER' ? 'GURU' : user.role === 'ADMIN' ? 'ADMIN' : 'SISWA';
          const photoSrc = user.profile_photo ? '/public/uploads/photos/' + user.profile_photo : null;
          const password = user.plain_password || '123456';
        %>
        <div class="login-card">
          <div class="card-header">
            <div class="card-logo">
              <img src="/public/images/logo.png" alt="Logo" onerror="this.style.display='none';this.parentElement.innerHTML='🎓';">
            </div>
            <div class="card-school-info">
              <div class="school-name"><%= schoolInfo.name %></div>
              <div class="school-sub"><%= schoolInfo.address %></div>
            </div>
          </div>

          <div class="card-body">
            <div class="card-left">
              <div class="card-title">Kartu Login</div>
              <div class="card-title-underline"></div>
              <div class="info-row">
                <span class="info-label">Nama</span>
                <span class="info-sep">:</span>
                <span class="info-value"><%= user.full_name %></span>
              </div>
              <div class="info-row">
                <span class="info-label">Kelas</span>
                <span class="info-sep">:</span>
                <span class="info-value"><%= user.class_name || roleText %></span>
              </div>
              <div class="info-row">
                <span class="info-label">Username</span>
                <span class="info-sep">:</span>
                <span class="info-value mono"><%= user.username %></span>
              </div>
              <div class="info-row">
                <span class="info-label">Password</span>
                <span class="info-sep">:</span>
                <span class="info-value mono"><%= password %></span>
              </div>
            </div>

            <div class="card-photo-wrap">
              <div class="hexagon">
                <% if (photoSrc) { %>
                  <img src="<%= photoSrc %>" alt="Foto">
                <% } else { %>
                  <div class="hexagon-placeholder">👤</div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="card-footer">
            Simpan kartu ini &bull; Jangan bagikan ke orang lain &bull; <%= schoolInfo.name %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <script>
    const totalPages = <%= totalPages %>;
    let currentPage = 0;

    function showPage(p) {
      document.querySelectorAll('.a4-page').forEach(el => el.classList.remove('active'));
      document.getElementById('page-' + p).classList.add('active');
      currentPage = p;
      renderPagination();
      window.scrollTo(0, 0);
    }

    function renderPagination() {
      const pg = document.getElementById('pagination');
      const info = document.getElementById('pageInfo');
      const start = currentPage * 8 + 1;
      const end = Math.min((currentPage + 1) * 8, <%= users.length %>);
      info.textContent = `Halaman ${currentPage + 1} dari ${totalPages} (kartu ${start}–${end} dari <%= users.length %>)`;

      let html = `<button class="page-btn" onclick="showPage(${currentPage - 1})" ${currentPage === 0 ? 'disabled' : ''}>‹ Prev</button>`;
      for (let i = 0; i < totalPages; i++) {
        if (totalPages <= 10 || Math.abs(i - currentPage) <= 2 || i === 0 || i === totalPages - 1) {
          html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="showPage(${i})">${i + 1}</button>`;
        } else if (Math.abs(i - currentPage) === 3) {
          html += `<span style="padding:0 4px;color:#999">…</span>`;
        }
      }
      html += `<button class="page-btn" onclick="showPage(${currentPage + 1})" ${currentPage === totalPages - 1 ? 'disabled' : ''}>Next ›</button>`;
      pg.innerHTML = html;
    }

    renderPagination();
  </script>
</body>
</html>
