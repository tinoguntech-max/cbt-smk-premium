<div class="flex items-center justify-between gap-4">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Import Password Siswa</h1>
    <p class="mt-1 text-slate-600">Update password siswa via file Excel atau CSV.</p>
  </div>
  <a href="/admin/users" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-100 font-medium">← Kembali</a>
</div>

<div class="mt-6 grid md:grid-cols-2 gap-6">

  <!-- Form Upload -->
  <div class="rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50 to-amber-50 p-6">
    <h2 class="font-semibold text-orange-900 mb-4">Upload File</h2>

    <form action="/admin/users/import-password" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="text-sm font-medium text-orange-800">Pilih File Excel (.xlsx) atau CSV (.csv)</label>
        <input type="file" name="file" accept=".xlsx,.csv" required
          class="mt-1 w-full rounded-xl border border-orange-200 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
      </div>
      <button type="submit"
        class="w-full rounded-xl bg-gradient-to-r from-orange-400 to-amber-500 hover:from-orange-500 hover:to-amber-600 text-white font-semibold py-3 transition-all shadow-md">
        Upload & Update Password
      </button>
    </form>

    <% if (typeof result !== 'undefined' && result) { %>
      <div class="mt-4 rounded-xl p-4 <%= result.errors.length > 0 ? 'bg-red-50 border border-red-200' : 'bg-green-50 border border-green-200' %>">
        <p class="font-semibold <%= result.errors.length > 0 ? 'text-red-700' : 'text-green-700' %>">
          ✅ Berhasil update: <%= result.updated %> akun
          <% if (result.notFound > 0) { %> | ⚠️ Tidak ditemukan: <%= result.notFound %><% } %>
          <% if (result.errors.length > 0) { %> | ❌ Error: <%= result.errors.length %><% } %>
        </p>
        <% if (result.errors.length > 0) { %>
          <ul class="mt-2 text-sm text-red-600 space-y-1">
            <% result.errors.forEach(e => { %><li>Baris <%= e.row %>: <%= e.msg %></li><% }) %>
          </ul>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Panduan Format -->
  <div class="rounded-2xl border border-blue-200 bg-gradient-to-br from-blue-50 to-indigo-50 p-6">
    <h2 class="font-semibold text-blue-900 mb-4">Format File</h2>
    <p class="text-sm text-blue-700 mb-3">File harus memiliki kolom berikut (header di baris pertama):</p>

    <div class="rounded-xl overflow-hidden border border-blue-200 text-sm">
      <table class="w-full">
        <thead class="bg-blue-100">
          <tr>
            <th class="px-4 py-2 text-left text-blue-800 font-semibold">username</th>
            <th class="px-4 py-2 text-left text-blue-800 font-semibold">password</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-blue-100">
          <tr>
            <td class="px-4 py-2 font-mono text-slate-700">0091774774@smkn1kras.sch.id</td>
            <td class="px-4 py-2 font-mono text-slate-700">password_baru</td>
          </tr>
          <tr>
            <td class="px-4 py-2 font-mono text-slate-700">0097925888@smkn1kras.sch.id</td>
            <td class="px-4 py-2 font-mono text-slate-700">password_baru</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-4 space-y-2 text-sm text-blue-700">
      <p>📌 Nama kolom bisa: <code class="bg-blue-100 px-1 rounded">username</code> atau <code class="bg-blue-100 px-1 rounded">nis</code></p>
      <p>📌 Nama kolom password bisa: <code class="bg-blue-100 px-1 rounded">password</code> atau <code class="bg-blue-100 px-1 rounded">pwd</code></p>
      <p>📌 Hanya akun dengan username yang cocok yang akan diupdate</p>
      <p>📌 Password lama tidak berubah jika kolom password kosong</p>
    </div>

    <a href="/admin/users/import-password/template"
      class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-500 hover:bg-blue-600 text-white text-sm font-semibold transition-all">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Download Template Excel
    </a>
  </div>

</div>
